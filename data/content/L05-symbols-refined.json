{
  "conceptId": "symbols",
  "lessonNumber": 5,
  "title": "Symbols",
  "introduce": {
    "content": {
      "icon": "→",
      "title": "Symbols = Fast Shortcuts",
      "subtitle": "Use symbols instead of words",
      "example": {
        "text": "Instead of: 'Rain causes flooding'",
        "highlight": "rain → flooding",
        "label": "(→ means 'causes' or 'leads to')"
      },
      "audio": "Symbols are fast shortcuts. Use symbols instead of words. Instead of 'Rain causes flooding', write 'rain arrow flooding'. The arrow means 'causes' or 'leads to'."
    }
  },
  "questions": [
