  "introduce": {
    "content": {
      "icon": "✂️",
      "title": "Short Notes = Better Notes",
      "subtitle": "Shorter is faster and easier to read",
      "example": {
        "text": "Instead of: 'The dog ran very fast down the street'",
        "highlight": "Dog ran fast down street",
        "label": "(Skip 'the' and 'very')"
      },
      "audio": "Short notes are better notes. Shorter is faster and easier to read. Instead of 'The dog ran very fast down the street', write 'Dog ran fast down street'. Skip words like 'the' and 'very'."
    }
  },
